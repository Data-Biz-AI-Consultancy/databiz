{
  "name": "databiz",
  "version": "1.0.0",
  "description": "Data Biz Consulting Website",
  "main": "main.js",
  "scripts": {
    "test:frontend": "vitest run --config=tests/frontend/vitest.config.js",
    "test:backend": "vitest run --config=tests/backend/vitest.config.js",
